{
  "name": "traitify-widgets",
  "version": "3.13.2",
  "author": "Traitify <support@traitify.com> (www.traitify.com)",
  "description": "Traitiy Widgets",
  "engines": {
    "node": ">=24.9.0"
  },
  "exports": {
    ".": "./build/traitify.js",
    "./standalone": "./build/standalone.js"
  },
  "files": [
    "build/*"
  ],
  "keywords": [
    "traitify",
    "personality",
    "widgets"
  ],
  "license": "MIT",
  "main": "./build/traitify.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traitify/traitify-widgets.git"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:compatibility -- --env output=standalone",
    "build:compatibility": "webpack --config-node-env production --env platform=browser --progress",
    "build:lib": "webpack --config-node-env production --progress",
    "dev": "webpack serve --env platform=browser",
    "dev:secure": "webpack serve --env platform=browser --server-type https",
    "i18n:sync": "cd packages/i18n-sync && npm run i18n:sync --",
    "i18n-sync:test": "cd packages/i18n-sync && npm run test --",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prebuild": "mkdirp build",
    "prebuild:compatibility": "mkdirp build",
    "prei18n-sync:test": "cd packages/i18n-sync && npm install --silent",
    "pretest": "npm run lint",
    "pretraitify:test": "npm run traitify:lint",
    "test": "npm-run-all *:test",
    "traitify:lint": "eslint {src,test}",
    "traitify:jest": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --config test/jest.config.js",
    "traitify:test": "npm run traitify:jest -- --coverage",
    "traitify:test:watch": "npm run traitify:jest -- --watch"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.13",
    "@babel/eslint-parser": "^7.29.13",
    "@babel/eslint-plugin": "^7.29.7",
    "@babel/plugin-proposal-export-default-from": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/register": "^7.29.13",
    "@babel/runtime": "^7.29.13",
    "autoprefixer": "^10.6.2",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "babel-plugin-jsx-pragmatic": "^1.0.2",
    "babel-preset-airbnb": "^5.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "eslint-config-traitify": "^1.0.0-alpha.3",
    "eslint-import-resolver-jest": "^3.0.2",
    "eslint-import-resolver-webpack": "^0.13.11",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^6.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mkdirp": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.32",
    "postcss-loader": "^8.2.1",
    "puppeteer": "^25.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "sass": "^1.107.1",
    "sass-loader": "^17.1.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  },
  "devDependenciesNotes": {
    "@babel/core": "waiting on babel-preset-airbnb for v8 support",
    "eslint": "waiting on eslint-plugin-react for v10 support",
    "postcss": "peer-dependency of postcss-loader"
  },
  "dependencies": {
    "@crosschq/interview-report-widget": "^0.5.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "bowser": "^2.15.0",
    "color": "^5.0.3",
    "core-js": "^3.51.0",
    "markdown-to-jsx": "^9.10.5",
    "prop-types": "^15.8.1",
    "recoil": "^0.7.7",
    "regenerator-runtime": "^0.14.1",
    "uuid": "^14.0.3"
  },
  "dependenciesNotes": {
    "@fortawesome/fontawesome-svg-core": "updated design in v7 maybe"
  },
  "peerDependencies": {
    "react": ">=18.0.0 || <19.0.0",
    "react-dom": ">=18.0.0 || <19.0.0"
  }
}
