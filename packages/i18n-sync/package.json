{
  "author": "Traitify <support@traitify.com> (www.traitify.com)",
  "description": "Internal Script",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-export-default-from": "^7.24.7",
    "@babel/runtime": "^7.25.6",
    "babel-jest": "^30.5.2",
    "babel-preset-airbnb": "^5.0.0",
    "eslint-webpack-plugin": "^6.0.0",
    "jest": "^30.5.2",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.3.1"
  },
  "devDependenciesNotes": {},
  "license": "MIT",
  "name": "@traitify/i18n-sync",
  "private": true,
  "repository": {
    "directory": "packages/i18n-sync",
    "type": "git",
    "url": "https://github.com/traitify/traitify-widgets.git"
  },
  "scripts": {
    "build": "webpack --config-node-env production --progress",
    "i18n:setup": "npm install && npm run build",
    "i18n:sync": "npm run i18n:sync:run --",
    "i18n:sync:run": "node build/i18n-sync.js",
    "prei18n:sync": "npm run i18n:setup",
    "jest": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --config test/jest.config.js",
    "test": "npm run jest -- --coverage",
    "test:watch": "npm run jest -- --watch"
  },
  "version": "0.0.0"
}
